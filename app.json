{
  "expo": {
    "name": "LINK",
    "slug": "link-social-mvp",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "LINK uses the camera to scan LINK QR cards and connect with people you meet."
      }
    },
    "android": {
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LINK to use your camera to scan LINK QR cards.",
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}